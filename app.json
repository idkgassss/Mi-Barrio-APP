{
  "expo": {
    "name": "Mi-Barrio-APP",
    "slug": "Mi-Barrio-APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mibarrio",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.MiBarrioAPP"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a Mi Barrio usar tu ubicación."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Mi Barrio acceder a tus fotos.",
          "cameraPermission": "Permite a Mi Barrio usar tu cámara para los reportes."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-dev-client"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9c730584-2290-4948-a1d2-c5947c0ab24a"
      }
    }
  }
}
