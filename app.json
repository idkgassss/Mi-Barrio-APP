{
  "expo": {
    "name": "Mi-Barrio-APP",
    "slug": "Mi-Barrio-APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mibarrio",
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyCoMXn15b_aSB2SP48vBk0hSKTBVnYnM8k"
      }
    },
    "android": {
      "package": "com.migrupo.mibarrio",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCoMXn15b_aSB2SP48vBk0hSKTBVnYnM8k"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a Mi Barrio usar tu ubicación."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Mi Barrio acceder a tus fotos.",
          "cameraPermission": "Permite a Mi Barrio usar tu cámara para los reportes."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "extraAndroidManifest": {
              "com.google.android.geo.API_KEY": "AIzaSyCoMXn15b_aSB2SP48vBk0hSKTBVnYnM8k"
            },
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "450c4a5d-0924-4dd8-add1-3572a2f0ce83"
      }
    }
  }
}
