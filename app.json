{
  "expo": {
    "name": "Mi-Barrio-APP",
    "slug": "Mi-Barrio-APP",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mibarrio",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.MiBarrioAPP"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Mi Barrio to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mi Barrio to access your photos."
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-google-signin/google-signin"
    ]
  }
}
